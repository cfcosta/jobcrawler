# Nix
/result
/result-*

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# direnv
/.direnv/

# Secrets — the LM provider key (OPENROUTER_API_KEY / OPENAI_API_KEY / ANTHROPIC_API_KEY)
# and the Codex OAuth token live in a local dotenv, never in the tree. The tracked
# template is deploy/jobcrawler.env.example (its name doesn't start with `.env`, so these
# rules don't touch it); `.envrc` is likewise safe (no dot after `env`).
.env
.env.*

# Operator identity — the three repo-root files config.py resolves by convention
# (JOBCRAWLER_PROFILE / JOBCRAWLER_AUTOFILL_NOTES / JOBCRAWLER_AUTOFILL_RESUME).
# They hold a real person's name, contact details, address and resume, so they are
# local-only inputs: every one of them is optional at runtime (a missing PROFILE.md
# means crawl-only mode; APPLY.md and CV.pdf are silently skipped when absent).
# README documents the PROFILE.md format with a placeholder if you need a template.
/PROFILE.md
/APPLY.md
/CV.pdf

# Runtime state / scratch
*.db
*.db-shm
*.db-wal
err.txt
# §4.11 optimize artifacts + CWD-relative state defaults (created when run from the
# repo root; production points the JOBCRAWLER_* paths at /var/lib instead).
optimize.lock
optimize.log
daemon.log
# single-instance flock for `jobcrawl run` (#26) — runtime state, sibling of optimize.lock
run.lock
trainset.jsonl
/generators/
/output
