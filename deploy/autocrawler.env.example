# bizup-autocrawler — deployment environment (§11)
#
# Copy to a real path the systemd unit reads (e.g. /etc/bizup-autocrawler/autocrawler.env),
# fill in the four REQUIRED values, then `chmod 600` it — it holds an API key.
#
# Only the cross-cutting knobs live here. The full config surface (caps, gate
# thresholds, politeness, scheduler) is documented in ../README.md and defaults
# sanely; set those here too only when you need to override a default.

# --- REQUIRED ---------------------------------------------------------------

# Provider API key for the LM. The model slug's `openrouter/` prefix tells
# litellm to read OPENROUTER_API_KEY (use OPENAI_API_KEY / ANTHROPIC_API_KEY
# instead if you point the model slugs at those providers). Read by litellm,
# not by the app's own config — so it never appears in `autocrawl`'s env table.
OPENROUTER_API_KEY=sk-or-REPLACE_ME

# RLM root planner/extractor — a strong, code-capable model. No default: an
# unset value fails loud at generate/optimize rather than 404-ing deep in the
# provider. Used only by `generate`/`optimize`; `run`/`crawl` need no LM.
AUTOCRAWLER_MODEL=openrouter/<vendor>/<strong-code-model>

# RLM sub_lm — a cheaper code-capable model for in-sandbox llm_query. Required:
# unset, every in-sandbox query silently bills at the root planner's rate.
AUTOCRAWLER_SUB_MODEL=openrouter/<vendor>/<cheap-code-model>

# Where committed crawlers POST extracted articles (the bizup-news ingest API).
# NOTE (containers): the default http://localhost:8000 means *the container*,
# not the host. Point this at a reachable address — host.containers.internal
# (podman) / host.docker.internal (docker, with --add-host …:host-gateway), a
# LAN IP, or the news service's DNS name on a shared container network.
NEWS_API_URL=http://host.containers.internal:8000

# --- OPTIONAL (uncomment to override defaults) ------------------------------

# GEPA reflection model for `autocrawl optimize` (§4.11). Ideally a strong model
# from a *different* family than AUTOCRAWLER_MODEL. Only needed if you run optimize.
#AUTOCRAWLER_REFLECTION_MODEL=anthropic/<strong-model>

# Daemon log verbosity (DEBUG|INFO|WARNING|ERROR). Default INFO.
#AUTOCRAWLER_LOG_LEVEL=INFO

# Cloudflare challenge solver (§4.10). Default `none` (plain httpx). The only
# built backend is flaresolverr; setting it requires FLARESOLVERR_URL.
#AUTOCRAWLER_SOLVER=none
#FLARESOLVERR_URL=http://flaresolverr:8191/v1

# --- AUTONOMY (the daemon's self-modification; §4.8 / §4.11 / §8) -----------
# The full knob surface (heal cooldown, body-quality floor, gen-fail backoff,
# adaptive cadence band, adoption probation) is in ../README.md and defaults
# sanely; the few below are the ones an operator most often touches.

# Master kill-switch over every self-modifying action (self-heal, auto-promote,
# reopt dispatch, auto-adopt). Default `on`. Set `off` to freeze the daemon's
# initiative while it keeps crawling/ingesting; operator commands still work.
#AUTOCRAWLER_AUTONOMY=on

# Self-heal delivery (§4.8/§14.2): `on` stages a healed crawler for `promote`;
# `auto` auto-promotes with a _history/ backup (undo via `rollback`); `off`
# writes live with no backup. Default `on`.
#AUTOCRAWLER_REVIEW_GATE=on

# Cadence of the offline GEPA re-optimization job (§4.11); `off` disables it.
# Each tick dispatches `autocrawl optimize` detached — never in the crawl loop.
#AUTOCRAWLER_REOPT_CHECK=off

# Webhook POSTed a small JSON payload on every autonomous action (heal/promote,
# adopt, generator rollback), alongside the log line. Best-effort. Unset ⇒ log only.
#AUTOCRAWLER_NOTIFY_WEBHOOK=https://hooks.example.com/autocrawler
