# bizup-autocrawler — container deployment (systemd + podman/docker).
#
# Runs the self-scheduling crawl daemon (§4.9) from the OCI image built by
# `nix build .#dockerImage` (a loadable layered image; no Docker daemon needed
# to *build* it). The image bakes the /data contract:
#   AUTOCRAWLER_SITES=/data/sites.yaml
#   AUTOCRAWLER_STATE_URL=sqlite:////data/autocrawler.db
#   AUTOCRAWLER_CRAWLERS_DIR=/data/crawlers  (committed crawlers + _pending staging)
#   DENO_DIR=/data/deno-cache            (Pyodide WASM cache, generate/optimize only)
# so the only host-side wiring is: bind-mount /data and supply the env file.
#
# Install (podman shown; substitute `docker` 1:1):
#   nix build .#packages.x86_64-linux.dockerImage
#   podman load < result                              # → bizup-autocrawler:latest
#   sudo install -d -m 700 /var/lib/bizup-autocrawler
#   sudo install -d -m 700 /etc/bizup-autocrawler
#   sudo install -m 600 deploy/autocrawler.env.example /etc/bizup-autocrawler/autocrawler.env
#   sudo $EDITOR /etc/bizup-autocrawler/autocrawler.env     # fill REQUIRED values
#   sudo install -m 644 deploy/sites.example.yaml /var/lib/bizup-autocrawler/sites.yaml
#   sudo $EDITOR /var/lib/bizup-autocrawler/sites.yaml      # your real seed list
#   sudo install -m 644 deploy/bizup-autocrawler.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now bizup-autocrawler
#
# Before first run, generate the per-site crawlers once. With the /data bind-mount
# they land in AUTOCRAWLER_CRAWLERS_DIR=/data/crawlers on the volume, so they persist
# across restarts and --rm — no image rebuild to add or self-heal a crawler (see
# ../README.md):
#   podman run --rm --env-file /etc/bizup-autocrawler/autocrawler.env \
#     -v /var/lib/bizup-autocrawler:/data bizup-autocrawler:latest autocrawl generate --all

[Unit]
Description=bizup-autocrawler — self-scheduling news crawler daemon
Documentation=file:///etc/bizup-autocrawler https://github.com/bizup/autocrawler
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# `--rm` so a crash never leaves a dead container blocking the next start; the
# baked image Healthcheck (`autocrawl status`, 60s) is honored by podman/docker
# and surfaced in `podman ps` / `podman healthcheck run bizup-autocrawler`.
ExecStartPre=-/usr/bin/podman rm -f bizup-autocrawler
ExecStart=/usr/bin/podman run --rm --name bizup-autocrawler \
    --env-file /etc/bizup-autocrawler/autocrawler.env \
    --volume /var/lib/bizup-autocrawler:/data \
    bizup-autocrawler:latest
ExecStop=/usr/bin/podman stop --time 20 bizup-autocrawler
# The daemon is meant to stay up; restart it on crash but rate-limit a crash loop.
Restart=on-failure
RestartSec=10s
StartLimitIntervalSec=300
StartLimitBurst=5
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
